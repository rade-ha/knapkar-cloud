{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "knapkar-cloud",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "knapkar","database_id": "03f3472b-c008-453b-9c07-4fcb53e94b19",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "knapkar-storage","preview_bucket_name": "knapkar-storage",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}